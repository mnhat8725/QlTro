@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="auth-form-container">
    <h2 class="auth-title">Đăng Nhập</h2>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="input-group">
            <label asp-for="Input.Email">Email</label>
            <div class="input-field">
                <i class="fas fa-envelope"></i>
                <input asp-for="Input.Email" placeholder="Nhập email của bạn" autocomplete="username" aria-required="true" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="input-group">
            <label asp-for="Input.Password">Mật khẩu</label>
            <div class="input-field">
                <i class="fas fa-lock"></i>
                <input asp-for="Input.Password" placeholder="Nhập mật khẩu" autocomplete="current-password" aria-required="true" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-options">
            <label class="remember-checkbox">
                <input asp-for="Input.RememberMe" />
                <span>Ghi nhớ đăng nhập</span>
            </label>
            <a id="forgot-password" asp-page="./ForgotPassword">Quên mật khẩu?</a>
        </div>

        <button id="login-submit" type="submit" class="auth-button">ĐĂNG NHẬP</button>

        @* <div class="signup-link">
            <p>Chưa có tài khoản?</p>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">ĐĂNG KÝ NGAY</a>
        </div> *@
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}