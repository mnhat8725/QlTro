@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Người Thuê</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tenant Layout CSS -->
    <link rel="stylesheet" href="~/css/tenant-layout.css">
</head>
<body>
    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-home"></i> NHÀ TRỌ</h3>
            <p>Hệ thống quản lý</p>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="user-info">
                <div class="user-avatar">
                    @User.Identity!.Name!.Substring(0, 1).ToUpper()
                </div>
                <div class="user-name">@User.Identity.Name</div>
                <div class="user-role">Người Thuê</div>
            </div>
        }

        <ul class="nav-menu">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Tenant" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Trang chủ</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyRoom" ? "active" : "")"
                   asp-controller="Tenant" asp-action="MyRoom">
                    <i class="fas fa-door-open"></i>
                    <span>Phòng của tôi</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyBills" ? "active" : "")"
                   asp-controller="Tenant" asp-action="MyBills">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>Hóa đơn của tôi</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PaymentHistory" ? "active" : "")"
                   asp-controller="Tenant" asp-action="PaymentHistory">
                    <i class="fas fa-history"></i>
                    <span>Lịch sử thanh toán</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
                   asp-controller="Tenant" asp-action="Profile">
                    <i class="fas fa-user"></i>
                    <span>Thông tin cá nhân</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </li>
        </ul>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
