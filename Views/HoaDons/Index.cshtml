@model IEnumerable<QuanLyNhaTro.Models.HoaDon>

@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hoadons.css" asp-append-version="true" />
}

<div class="container-fluid fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-file-invoice-dollar text-primary"></i> Quản lý Hóa đơn
            </h2>
            <p class="text-muted mb-0">Quản lý và theo dõi các hóa đơn tiền phòng</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo hóa đơn mới
            </a>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thống kê -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-primary bg-opacity-10">
                            <i class="fas fa-file-invoice text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="stat-label">Tổng hóa đơn</p>
                            <h3 class="stat-value mb-0">@ViewBag.TongSoHoaDon</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning bg-opacity-10">
                            <i class="fas fa-clock text-warning"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="stat-label">Chưa thanh toán</p>
                            <h3 class="stat-value mb-0">@ViewBag.SoChuaThanhToan</h3>
                            <small class="stat-subtext">@ViewBag.TongTienChuaTT.ToString("N0") đ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success bg-opacity-10">
                            <i class="fas fa-check-circle text-success"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="stat-label">Đã thanh toán</p>
                            <h3 class="stat-value mb-0">@ViewBag.SoDaThanhToan</h3>
                            <small class="stat-subtext">@ViewBag.TongTienDaTT.ToString("N0") đ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-money-bill-wave fa-3x opacity-50"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <p class="stat-label text-white-50">Tổng doanh thu</p>
                            <h4 class="stat-value mb-0">@((ViewBag.TongTienChuaTT + ViewBag.TongTienDaTT).ToString("N0")) đ</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc -->
    <div class="card filter-card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </label>
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           class="form-control" placeholder="Phòng hoặc người thuê...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">
                        <i class="fas fa-calendar"></i> Tháng
                    </label>
                    <select name="thang" class="form-select">
                        <option value="">Tất cả</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(ViewBag.Thang == i)">Tháng @i</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">
                        <i class="fas fa-calendar-alt"></i> Năm
                    </label>
                    <select name="nam" class="form-select">
                        <option value="">Tất cả</option>
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                        {
                            <option value="@i" selected="@(ViewBag.Nam == i)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        <i class="fas fa-filter"></i> Trạng thái
                    </label>
                    <select name="trangThai" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="0" selected="@(ViewBag.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.ChuaThanhToan)">Chưa thanh toán</option>
                        <option value="1" selected="@(ViewBag.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.DaThanhToan)">Đã thanh toán</option>
                        <option value="2" selected="@(ViewBag.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.QuaHan)">Quá hạn</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="fas fa-search"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="card shadow-custom rounded-custom">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hoadon align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã HĐ</th>
                            <th>Phòng</th>
                            <th>Người thuê</th>
                            <th>Tháng</th>
                            <th class="text-end">Tiền phòng</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @{
                                        var rand = new Random();
                                        string suffix = ((char)rand.Next(65, 90)).ToString() + rand.Next(10, 99).ToString();
                                        string code = $"HD{item.Id:D5}{suffix}";
                                    }
                                    <td>
                                        <span class="invoice-code">#@code</span>
                                    </td>
                                    <td>
                                        <i class="icon-col fas fa-door-open"></i>
                                        <strong>@item.HopDong?.Phong?.TenPhong</strong>
                                    </td>
                                    <td>
                                        <i class="icon-col fas fa-user"></i>
                                        @item.HopDong?.NguoiThue?.HoTen
                                    </td>
                                    <td>
                                        <i class="icon-col fas fa-calendar-alt"></i>
                                        @item.ThangNam.ToString("MM/yyyy")
                                    </td>
                                    <td class="text-end amount-secondary">
                                        @item.TienPhong.ToString("N0") đ
                                    </td>
                                    <td class="text-end">
                                        <span class="amount-display">@item.TongTien.ToString("N0") đ</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.DaThanhToan)
                                        {
                                            <span class="badge-status status-paid">
                                                <i class="fas fa-check-circle"></i> Đã thanh toán
                                            </span>
                                            @if (item.NgayThanhToan.HasValue)
                                            {
                                                <br>
                                
                                                <small class="text-muted">@item.NgayThanhToan.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                        }
                                        else if (item.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.ChuaThanhToan)
                                        {
                                            <span class="badge-status status-unpaid">
                                                <i class="fas fa-clock"></i> Chưa thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-status status-overdue">
                                                <i class="fas fa-exclamation-triangle"></i> Quá hạn
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-action btn-outline-info" title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-action btn-outline-primary" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (item.TrangThai == QuanLyNhaTro.Models.TrangThaiHoaDon.ChuaThanhToan)
                                            {
                                                <button type="button" class="btn btn-action btn-outline-success"
                                                        title="Đánh dấu đã thanh toán"
                                                        onclick="markAsPaid(@item.Id)">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-action btn-outline-danger" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="empty-state-icon fas fa-inbox"></i>
                                        <h5 class="empty-state-title">Không có hóa đơn nào</h5>
                                        <p class="empty-state-text">Hãy tạo hóa đơn mới để bắt đầu</p>
                                        <a asp-action="Create" class="btn btn-primary">
                                            <i class="fas fa-plus"></i> Tạo hóa đơn mới
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form ẩn để đánh dấu đã thanh toán -->
<form id="markAsPaidForm" method="post" asp-action="MarkAsPaid" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="markAsPaidId" name="id" />
</form>

@section Scripts {
    <script>
        function markAsPaid(id) {
            if (confirm('Xác nhận đánh dấu hóa đơn này là đã thanh toán?')) {
                document.getElementById('markAsPaidId').value = id;
                document.getElementById('markAsPaidForm').submit();
            }
        }
    </script>
}
