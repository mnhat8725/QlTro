@model IEnumerable<QuanLyNhaTro.Models.HopDong>

@{
    ViewData["Title"] = "Quản lý hợp đồng";
}

<div class="container-fluid mt-4">
    <!-- ============================================ -->
    <!-- PHẦN THÔNG BÁO (Messages & Notifications)   -->
    <!-- ============================================ -->
    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    @if (TempData["AccountInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert"
             style="max-width: 100%; overflow-wrap: break-word; word-wrap: break-word;">
            <div class="row">
                <div class="col-12">
                    <h5 class="alert-heading mb-3">
                        <i class="fas fa-user-plus"></i> Tài khoản đăng nhập đã được tạo!
                    </h5>
                    <hr>
                    <div class="mb-3" style="font-size: 1rem; line-height: 2;">
                        @Html.Raw(TempData["AccountInfo"])
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-primary btn-sm" onclick="copyAccountInfo()">
                            <i class="fas fa-copy"></i> Copy thông tin
                        </button>
                        <button type="button" class="btn btn-success btn-sm" onclick="printAccountInfo()">
                            <i class="fas fa-print"></i> In phiếu thông tin
                        </button>
                    </div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"
                    style="position: absolute; top: 10px; right: 10px;"></button>
        </div>
    }
   

    
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert"
                 style="max-width: 100%; word-wrap: break-word;">
                <i class="fas fa-info-circle"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    <!-- Warning Message -->
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert"
             style="max-width: 100%; overflow-wrap: break-word; word-wrap: break-word; white-space: pre-wrap;">
            <div class="d-flex align-items-start">
                <i class="fas fa-exclamation-triangle me-2 mt-1"></i>
                <div style="flex: 1;">
                    <strong>Cảnh báo:</strong><br />
                    <span style="font-size: 0.9rem;">@TempData["WarningMessage"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"
                    style="position: absolute; top: 10px; right: 10px;"></button>
        </div>
    }

    <!-- ============================================ -->
    <!-- PHẦN NỘI DUNG CHÍNH (Main Content)          -->
    <!-- ============================================ -->
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-file-contract"></i> Quản lý hợp đồng</h2>
            <p class="text-muted mb-0">Quản lý hợp đồng thuê phòng</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo hợp đồng mới
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Tổng hợp đồng</h5>
                    <h2 class="mb-0">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Đang hiệu lực</h5>
                    <h2 class="mb-0">@Model.Count(h => h.NgayKetThuc == null || h.NgayKetThuc > DateTime.Now)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Đã hết hạn</h5>
                    <h2 class="mb-0">@Model.Count(h => h.NgayKetThuc != null && h.NgayKetThuc < DateTime.Now)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Mã HĐ</th>
                                <th>Phòng</th>
                                <th>Người thuê</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isActive = item.NgayKetThuc == null || item.NgayKetThuc > DateTime.Now;
                                <tr>
                                    <td><strong>#HD@(item.Id.ToString("D4"))</strong></td>
                                    <td>
                                        <i class="fas fa-door-open text-primary"></i>
                                        @item.Phong?.TenPhong
                                    </td>
                                    <td>
                                        <i class="fas fa-user text-secondary"></i>
                                        @item.NguoiThue?.HoTen
                                    </td>
                                    <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.NgayKetThuc.HasValue)
                                        {
                                            @item.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không xác định</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Đang hiệu lực
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle"></i> Đã hết hạn
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-info" title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-warning" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-danger" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h4>Chưa có hợp đồng nào</h4>
                    <p class="text-muted">Hãy tạo hợp đồng mới để bắt đầu quản lý</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Tạo hợp đồng đầu tiên
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hopdong.js"></script>
}

