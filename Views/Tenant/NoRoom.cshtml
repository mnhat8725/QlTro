@{
    ViewData["Title"] = "Không có phòng";
    Layout = "~/Views/Shared/_TenantLayout.cshtml";
}

<div class="content-wrapper text-center py-5">
    <div style="max-width: 500px; margin: 0 auto;">
        <!-- ICON -->
        <div class="mb-4">
            <i class="fas fa-home fa-5x text-muted"></i>
        </div>

        <!-- TITLE -->
        <h2 class="mb-3">Bạn chưa có phòng nào</h2>

        <!-- MESSAGE -->
        @if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @ViewBag.Message
            </div>
        }

        <!-- DESCRIPTION -->
        <p class="text-muted mb-4">
            Tài khoản của bạn chưa được liên kết với phòng trọ nào.
            Vui lòng liên hệ chủ trọ hoặc quản trị viên để được hỗ trợ.
        </p>

        <!-- CONTACT INFO -->
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-phone-alt me-2"></i>Liên hệ
                </h5>
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted">Hotline:</td>
                        <td class="fw-bold">
                            <a href="tel:0912345679" class="text-decoration-none">
                                <i class="fas fa-phone me-1"></i>0912345679
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Email:</td>
                        <td class="fw-bold">
                            <a href="mailto:chutro@nhatro.com" class="text-decoration-none">
                                <i class="fas fa-envelope me-1"></i>chutro@nhatro.com
                            </a>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="d-grid gap-2">
            <a href="tel:0912345679" class="btn btn-primary btn-lg">
                <i class="fas fa-phone me-2"></i>Gọi ngay cho chủ trọ
            </a>
            <a href="mailto:chutro@nhatro.com" class="btn btn-outline-secondary">
                <i class="fas fa-envelope me-2"></i>Gửi email
            </a>
        </div>

        <!-- FAQ -->
        <div class="text-start mt-5">
            <h6 class="mb-3">
                <i class="fas fa-question-circle me-2"></i>Câu hỏi thường gặp
            </h6>
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            Tại sao tôi không thấy thông tin phòng?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Có thể chủ trọ chưa tạo hợp đồng thuê cho bạn trong hệ thống.
                            Vui lòng liên hệ chủ trọ để được hỗ trợ.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Làm sao để xem hóa đơn?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Sau khi có hợp đồng thuê, bạn sẽ tự động nhìn thấy menu "Hóa đơn của tôi"
                            và có thể xem tất cả hóa đơn.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            Tôi cần cung cấp thông tin gì?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Bạn cần cung cấp: Họ tên, số CCCD, số điện thoại, và địa chỉ email
                            để chủ trọ tạo hồ sơ cho bạn.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
