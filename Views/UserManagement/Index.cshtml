    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<QuanLyNhaTro.Models.NguoiThue>

@{
    ViewData["Title"] = "Quản lý tài khoản người thuê";
}

<div class="container-fluid mt-4">
    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["AccountInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm">
            <h5 class="alert-heading">
                <i class="fas fa-user-plus"></i> Tài khoản mới đã được tạo!
            </h5>
            <hr>
            <div class="mb-3">
                @Html.Raw(TempData["AccountInfo"])
            </div>
            <button type="button" class="btn btn-primary btn-sm" onclick="copyInfo()">
                <i class="fas fa-copy"></i> Copy
            </button>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-times-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-users-cog"></i> Quản lý tài khoản người thuê</h2>
            <p class="text-muted mb-0">Tạo và quản lý tài khoản đăng nhập cho người thuê</p>
        </div>
        <div>
            @if (Model.Any())
            {
                <form asp-action="CreateAllAccounts" method="post" style="display:inline;"
                      onsubmit="return confirm('Tạo tài khoản cho tất cả người thuê chưa có tài khoản?')">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-user-plus"></i> Tạo tất cả tài khoản
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Danh sách -->
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Họ tên</th>
                                <th>Số điện thoại</th>
                                <th>CCCD</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>
                                        <i class="fas fa-user text-primary"></i>
                                        <strong>@item.HoTen</strong>
                                    </td>
                                    <td>
                                        <i class="fas fa-phone text-muted"></i>
                                        @item.SoDienThoai
                                    </td>
                                    <td>@item.SoCCCD</td>
                                    <td>
                                        <span class="badge bg-warning">
                                            <i class="fas fa-exclamation-circle"></i> Chưa có tài khoản
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="CreateAccount" method="post" style="display:inline;">
                                            <input type="hidden" name="nguoiThueId" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm"
                                                    onclick="return confirm('Tạo tài khoản cho @item.HoTen?')">
                                                <i class="fas fa-user-plus"></i> Tạo tài khoản
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h4>Tất cả người thuê đã có tài khoản!</h4>
                    <p class="text-muted">Không có người thuê nào cần tạo tài khoản</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyInfo() {
            var alertDiv = document.querySelector('.alert-info');
            if (alertDiv) {
                var text = alertDiv.innerText;
                navigator.clipboard.writeText(text).then(function() {
                    alert('✅ Đã copy thông tin!');
                });
            }
        }
    </script>
}
