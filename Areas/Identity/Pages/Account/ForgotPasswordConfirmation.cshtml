@page
@model QuanLyNhatro.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Đã gửi email";
    Layout = "_AuthLayout";
}

<div class="auth-form-container">
    <div class="auth-icon success-icon">
        <i class="fas fa-envelope-circle-check"></i>
    </div>

    <h2 class="auth-title">Email Đã Được Gửi! 📧</h2>
    <p class="auth-subtitle">
        Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến email của bạn.
        <br><br>
        Vui lòng kiểm tra hộp thư và làm theo hướng dẫn.
    </p>

    <div class="email-check-tips" style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin: 20px 0; text-align: left;">
        <p style="margin: 0; font-size: 14px; color: #666;">
            <strong><i class="fas fa-lightbulb me-2" style="color: #ffc107;"></i>Mẹo:</strong>
        </p>
        <ul style="margin: 10px 0 0 20px; padding: 0; font-size: 14px; color: #666;">
            <li>Kiểm tra cả thư mục Spam</li>
            <li>Email có thể mất vài phút để gửi đến</li>
            <li>Link đặt lại mật khẩu có hiệu lực trong 24 giờ</li>
        </ul>
    </div>

    <a asp-page="./Login" class="auth-button" style="text-decoration: none; display: block;">
        <i class="fas fa-arrow-left me-2"></i>Quay lại đăng nhập
    </a>
</div>

<style>
    .auth-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 36px;
        color: white;
    }

    .success-icon {
        background: linear-gradient(135deg, #43a047 0%, #66bb6a 100%);
        animation: scaleIn 0.5s ease;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>