    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@using QuanLyNhatro.ViewModels
@model UserDetailsViewModel
@{
    ViewData["Title"] = "Chi Tiết Người Dùng";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>Chi Tiết Người Dùng
                    </h4>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">
                                    <i class="fas fa-envelope me-2 text-primary"></i>Email:
                                </th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-user me-2 text-primary"></i>Tên đăng nhập:
                                </th>
                                <td>@Model.UserName</td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-phone me-2 text-primary"></i>Số điện thoại:
                                </th>
                                <td>@(Model.PhoneNumber ?? "Chưa cập nhật")</td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-check-circle me-2 text-primary"></i>Xác thực email:
                                </th>
                                <td>
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Đã xác thực</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Chưa xác thực</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-shield-alt me-2 text-primary"></i>Quyền:
                                </th>
                                <td>
                                    @if (Model.Roles.Any())
                                    {
                                        foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary me-1">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa có quyền</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="fas fa-lock me-2 text-primary"></i>Trạng thái:
                                </th>
                                <td>
                                    @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTimeOffset.UtcNow)
                                    {
                                        <span class="badge bg-danger">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                        <div>
                            <a asp-action="AssignRole" asp-route-id="@Model.UserId"
                               class="btn btn-warning me-2">
                                <i class="fas fa-user-shield me-2"></i>Phân quyền
                            </a>
                            @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTimeOffset.UtcNow)
                            {
                                <form asp-controller="Users" asp-action="UnlockUser"
                                      asp-route-userId="@Model.UserId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-unlock me-2"></i>Mở khóa
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Users" asp-action="LockUser"
                                      asp-route-userId="@Model.UserId" method="post" style="display:inline;"
                                      onsubmit="return confirm('Bạn có chắc muốn khóa tài khoản này?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-lock me-2"></i>Khóa
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>