@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Xác thực thành công";
    Layout = "_AuthLayout";
}

<div class="auth-form-container">
    <div class="auth-icon success-icon">
        <i class="fas fa-check-circle"></i>
    </div>

    <h2 class="auth-title">Xác Thực Thành Công! 🎉</h2>
    <p class="auth-subtitle">
        Tài khoản của bạn đã được kích hoạt
        <br>
        Giờ bạn có thể đăng nhập rồi
    </p>

    <a asp-page="./Login" class="auth-button" style="text-decoration: none; display: block;">
        <i class="fas fa-sign-in-alt me-2"></i>ĐĂNG NHẬP NGAY
    </a>
</div>

<style>
    .auth-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 36px;
        color: white;
    }

    .success-icon {
        background: linear-gradient(135deg, #43a047 0%, #66bb6a 100%);
        animation: scaleIn 0.5s ease;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>