@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-form-container">
    <div class="auth-icon">
        <i class="fas fa-lock-open"></i>
    </div>
    <h2 class="auth-title">Đặt Lại Mật Khẩu</h2>
    <p class="auth-subtitle">Nhập mật khẩu mới cho tài khoản của bạn</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <div class="input-group">
            <label asp-for="Input.Email">Email</label>
            <div class="input-field">
                <i class="fas fa-envelope"></i>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Nhập email của bạn" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="input-group">
            <label asp-for="Input.Password">Mật khẩu mới</label>
            <div class="input-field">
                <i class="fas fa-lock"></i>
                <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="input-group">
            <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
            <div class="input-field">
                <i class="fas fa-lock"></i>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu mới" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="auth-button">
            <i class="fas fa-check me-2"></i>ĐẶT LẠI MẬT KHẨU
        </button>

        <div class="signup-link">
            <a asp-page="./Login">
                <i class="fas fa-arrow-left me-2"></i>Quay lại đăng nhập
            </a>
        </div>
    </form>
</div>

<style>
    .auth-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 36px;
        color: white;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}